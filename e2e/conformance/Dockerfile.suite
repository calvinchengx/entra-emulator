# The conformance suite is a Java process, so it validates the emulator's TLS
# certificate against the JDK truststore. The emulator's certificate is
# self-signed AND marked IsCA (internal/tlscert/cert.go), so importing the leaf
# is enough — there is no separate CA to chain to.
#
# Deriving from the published image rather than wrapping its entrypoint means
# the upstream ENTRYPOINT is inherited verbatim and cannot drift out of sync
# with a copy pasted here.
ARG SUITE_IMAGE
FROM ${SUITE_IMAGE}

COPY .certs/cert.pem /tmp/entra-emulator-ca.pem

RUN keytool -importcert -noprompt -trustcacerts \
      -alias entra-emulator \
      -file /tmp/entra-emulator-ca.pem \
      -keystore "$JAVA_HOME/lib/security/cacerts" \
      -storepass changeit
