{
  "name": "entra-emulator-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "undici@<7.30.1": "7.30.1",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "postcss@<8.5.23": "8.5.23",
      "nanoid@<3.3.18": "3.3.18",
      "lodash-es@<4.18.0": "4.18.1",
      "devalue@>=5.0.0 <5.9.3": "^5.9.3",
      "dompurify@>=3.4.13 <3.4.17": "^3.4.17",
      "katex@<0.18.2": "^0.18.2",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "source-map-js@<1.2.2": "^1.2.2",
      "smol-toml@<1.9.0": "^1.9.0",
      "http-cache-semantics@<4.3.0": "^4.3.0",
      "zod@>=4.0.0 <4.6.6": "^4.6.6"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "portal:build": "pnpm --filter entra-emulator-portal build",
    "docs:dev": "pnpm --filter entra-emulator-docs dev",
    "docs:build": "pnpm --filter entra-emulator-docs build"
