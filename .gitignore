# Runtime state — the emulator's store, created at the repo root on first run.
# Anchored with a leading slash: a bare `data/` matches a directory of that name
# at ANY depth, which silently swallowed website/src/data/ too. That one is
# ignored deliberately by website/.gitignore; anything else landing in a nested
# data/ should be visible rather than disappear.
/data/
*.log

# Locally built binary (`make build`, or the README's `go build ./cmd/...`),
# which lands in the repo root. Both spellings: Windows appends .exe, and only
# ignoring the bare name leaves a 25 MB file for `git add -A` to pick up there.
/entra-emulator
/entra-emulator.exe

# Node
node_modules/

# Python
.venv/
__pycache__/

# Local tooling
.claude/

.nwave/
# Note: portal/dist IS committed — go:embed needs it for `go build` to be
# self-sufficient. Rebuild with `pnpm --filter entra-emulator-portal build`.

# Xcode/Flutter build output that lands outside the app dir
e2e/build/

# GoReleaser build output (release binaries + generated cask)
/dist/

# Playwright
test-results/
playwright-report/
